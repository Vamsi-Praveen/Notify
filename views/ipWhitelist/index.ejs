<div class="w-full space-y-6">
  <!-- Header -->
  <div class="pb-6 border-b border-slate-100 flex items-center justify-between">
    <div>
      <h2 class="text-lg font-bold text-slate-800">IP Allowlist Management</h2>
      <p class="text-xs text-slate-500 mt-1">
        Restrict API access to specific IP addresses for enhanced security.
      </p>
    </div>
    <button
      onclick="toggleAddModal()"
      class="inline-flex items-center px-4 py-2 bg-slate-900 hover:bg-black text-white text-[10px] font-bold uppercase tracking-widest rounded transition-all gap-2"
    >
      <i data-lucide="plus" class="w-3.5 h-3.5"></i> Register IP
    </button>
  </div>

  <!-- Search Area -->
  <div class="bg-white border border-slate-200 rounded-lg overflow-hidden shadow-sm">
    <div class="p-4 border-b border-slate-100 bg-slate-50/30">
      <div class="relative max-w-sm">
        <i
          data-lucide="search"
          class="absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-slate-400"
        ></i>
        <input
          type="text"
          id="ipSearch"
          onkeyup="filterIps()"
          placeholder="Search IP, Tenant, or API Key..."
          class="w-full pl-9 pr-4 py-2 bg-white border border-slate-200 rounded text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition-all font-medium"
        />
      </div>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead
          class="bg-slate-50/50 text-[10px] font-bold text-slate-500 uppercase tracking-widest border-b border-slate-100"
        >
          <tr>
            <th class="px-6 py-4">IP Address</th>
            <th class="px-6 py-4">Scope</th>
            <th class="px-6 py-4">Associated Entity</th>
            <th class="px-6 py-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (ipEntries && ipEntries.length > 0) { ipEntries.forEach(entry => { %>
          <tr class="hover:bg-slate-50/50 transition-colors ip-row">
            <td class="px-6 py-4">
              <div class="text-xs font-bold text-slate-800 ip-addr font-mono"><%= entry.ip %></div>
            </td>
            <td class="px-6 py-4">
              <span
                class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold uppercase border <%= entry.type === 'tenant' ? 'bg-blue-50 text-blue-700 border-blue-100' : 'bg-purple-50 text-purple-700 border-purple-100' %>"
              >
                <%= entry.type === 'tenant' ? 'Tenant Policy' : 'API Key Policy' %>
              </span>
            </td>
            <td class="px-6 py-4">
              <div class="text-xs font-medium text-slate-600 entity-name"><%= entry.context %></div>
            </td>
            <td class="px-6 py-4 text-right">
              <button
                onclick="openDeleteModal('<%= entry.type %>', '<%= entry.entityId %>', '<%= entry.ip %>')"
                class="p-1.5 text-slate-400 hover:text-red-600 transition-colors"
              >
                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
              </button>
            </td>
          </tr>
          <% }) %> <% } else { %>
          <tr id="emptyCell">
            <td colspan="4" class="px-6 py-12 text-center text-slate-400 text-xs lowercase">
              No IP restrictions found.
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Backsplash -->
<div
  id="modalBackdrop"
  class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-40 hidden transition-opacity"
></div>

<!-- Add IP Modal -->
<div
  id="addIpModal"
  class="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md z-50 hidden"
>
  <div
    class="bg-white rounded shadow-2xl border border-slate-200 overflow-hidden transform transition-all"
  >
    <div
      class="px-6 py-4 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between"
    >
      <h3 class="text-xs font-bold text-slate-800 uppercase tracking-widest">Authorize New IP</h3>
      <button onclick="toggleAddModal()" class="text-slate-400 hover:text-slate-600">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>

    <form onsubmit="handleCreateIp(event)" class="p-6 space-y-4">
      <!-- Target Type Selection -->
      <div class="space-y-2">
        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest"
          >Policy Type</label
        >
        <div class="flex gap-4">
          <label class="flex items-center gap-2 cursor-pointer">
            <input
              type="radio"
              name="type"
              value="tenant"
              checked
              onchange="toggleSelects()"
              class="text-blue-600 focus:ring-blue-500"
            />
            <span class="text-xs font-medium text-slate-700">Tenant Level</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input
              type="radio"
              name="type"
              value="apikey"
              onchange="toggleSelects()"
              class="text-purple-600 focus:ring-purple-500"
            />
            <span class="text-xs font-medium text-slate-700">API Key Level</span>
          </label>
        </div>
      </div>

      <!-- Tenant Select -->
      <div id="tenantSelectGroup" class="space-y-2">
        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest"
          >Target Tenant</label
        >
        <select
          id="tenantIdSelect"
          class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition-all font-medium"
        >
          <option value="" disabled selected>Select a tenant...</option>
          <% if (tenants && tenants.length > 0) { tenants.forEach(t => { %>
          <option value="<%= t._id %>"><%= t.name %></option>
          <% }) } %>
        </select>
      </div>

      <!-- API Key Select -->
      <div id="apiKeySelectGroup" class="space-y-2 hidden">
        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest"
          >Target API Key</label
        >
        <select
          id="apiKeyIdSelect"
          class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded text-xs focus:outline-none focus:ring-1 focus:ring-purple-500 transition-all font-medium"
        >
          <option value="" disabled selected>Select an API Key...</option>
          <% if (apiKeys && apiKeys.length > 0) { apiKeys.forEach(k => { %>
          <option value="<%= k._id %>">
            <%= k.name %> (<%= k.tenantId ? k.tenantId.name : 'System' %>)
          </option>
          <% }) } %>
        </select>
      </div>

      <!-- IP Input -->
      <div class="space-y-2">
        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest"
          >IP Address</label
        >
        <input
          type="text"
          name="ip"
          required
          placeholder="e.g. 192.168.1.10"
          class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded text-xs focus:outline-none focus:ring-1 focus:ring-blue-500 transition-all font-mono"
        />
      </div>

      <div class="flex items-center justify-end gap-3 pt-4">
        <button
          type="button"
          onclick="toggleAddModal()"
          class="px-4 py-2 text-[10px] font-bold text-slate-500 uppercase tracking-widest hover:text-slate-800"
        >
          Cancel
        </button>
        <button
          type="submit"
          class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white text-[10px] font-bold uppercase tracking-widest rounded shadow-sm transition-all transform active:scale-95"
        >
          Allow IP
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div
  id="deleteConfirmModal"
  class="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-sm z-50 hidden"
>
  <div
    class="bg-white rounded shadow-2xl border border-slate-200 overflow-hidden transform transition-all"
  >
    <div class="px-6 py-4 border-b border-slate-100 bg-red-50/50 flex items-center justify-between">
      <h3 class="text-xs font-bold text-red-800 uppercase tracking-widest">Revoke Access</h3>
      <button onclick="closeDeleteModal()" class="text-slate-400 hover:text-slate-600">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>
    <div class="p-6">
      <p class="text-sm text-slate-600 mb-4">
        Are you sure you want to remove IP
        <span id="deleteIpTarget" class="font-mono font-bold text-slate-800"></span> from the
        allowlist?
      </p>
      <p class="text-xs text-slate-500">
        This will immediately block API access from this address.
      </p>

      <div class="flex items-center justify-end gap-3 pt-6">
        <button
          type="button"
          onclick="closeDeleteModal()"
          class="px-4 py-2 text-[10px] font-bold text-slate-500 uppercase tracking-widest hover:text-slate-800"
        >
          Cancel
        </button>
        <button
          type="button"
          onclick="confirmDelete()"
          class="px-6 py-2 bg-red-600 hover:bg-red-700 text-white text-[10px] font-bold uppercase tracking-widest rounded shadow-sm transition-all transform active:scale-95"
        >
          Revoke
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function toggleAddModal() {
    const modal = document.getElementById('addIpModal');
    const backdrop = document.getElementById('modalBackdrop');
    const isHidden = modal.classList.contains('hidden');

    if (isHidden) {
      modal.classList.remove('hidden');
      backdrop.classList.remove('hidden');
    } else {
      modal.classList.add('hidden');
      backdrop.classList.add('hidden');
    }
  }

  function toggleSelects() {
    const type = document.querySelector('input[name="type"]:checked').value;
    const tenantGroup = document.getElementById('tenantSelectGroup');
    const apiKeyGroup = document.getElementById('apiKeySelectGroup');

    if (type === 'tenant') {
      tenantGroup.classList.remove('hidden');
      apiKeyGroup.classList.add('hidden');
    } else {
      tenantGroup.classList.add('hidden');
      apiKeyGroup.classList.remove('hidden');
    }
  }

  function filterIps() {
    const input = document.getElementById('ipSearch');
    const filter = input.value.toLowerCase();
    const rows = document.querySelectorAll('.ip-row');
    let visibleCount = 0;

    rows.forEach((row) => {
      const ip = row.querySelector('.ip-addr').textContent.toLowerCase();
      const entity = row.querySelector('.entity-name').textContent.toLowerCase();
      if (ip.includes(filter) || entity.includes(filter)) {
        row.style.display = '';
        visibleCount++;
      } else {
        row.style.display = 'none';
      }
    });

    const emptyCell = document.getElementById('emptyCell');
    if (emptyCell) {
      // Simple logic for empty cell vs filtered
      // For now, let's keep it visible if no rows at all, otherwise let CSS handle it via filter
    }
  }

  async function handleCreateIp(e) {
    e.preventDefault();
    const form = e.target;
    const type = form.querySelector('input[name="type"]:checked').value;
    const ip = form.ip.value;

    let entityId;
    if (type === 'tenant') {
      entityId = document.getElementById('tenantIdSelect').value;
    } else {
      entityId = document.getElementById('apiKeyIdSelect').value;
    }

    if (!entityId) {
      alert('Please select a target entity');
      return;
    }

    try {
      const res = await fetch('/admin/admin-api/ip-whitelist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type, entityId, ip }),
      });

      const result = await res.json();
      if (res.ok) {
        window.location.reload();
      } else {
        alert(result.message || 'Operation failed');
      }
    } catch (err) {
      alert('Network error');
    }
  }

  // Delete Modal State
  let deleteTarget = null;

  function openDeleteModal(type, entityId, ip) {
    deleteTarget = { type, entityId, ip };
    document.getElementById('deleteIpTarget').textContent = ip;

    document.getElementById('deleteConfirmModal').classList.remove('hidden');
    document.getElementById('modalBackdrop').classList.remove('hidden');
  }

  function closeDeleteModal() {
    deleteTarget = null;
    document.getElementById('deleteConfirmModal').classList.add('hidden');
    document.getElementById('modalBackdrop').classList.add('hidden');
  }

  async function confirmDelete() {
    if (!deleteTarget) return;

    const { type, entityId, ip } = deleteTarget;

    try {
      const res = await fetch(
        `/admin/admin-api/ip-whitelist/${type}/${entityId}/${encodeURIComponent(ip)}`,
        {
          method: 'DELETE',
        }
      );
      const result = await res.json();
      if (res.ok) {
        window.location.reload();
      } else {
        alert(result.message || 'Revocation failed');
        closeDeleteModal();
      }
    } catch (e) {
      alert('Network error');
      closeDeleteModal();
    }
  }
</script>
