<!-- Custom Alert Modal -->
<div
  id="customAlert"
  class="relative z-[100] hidden"
  aria-labelledby="modal-title"
  role="dialog"
  aria-modal="true"
>
  <div class="fixed inset-0 bg-black/60 backdrop-blur-sm transition-opacity"></div>

  <div class="fixed inset-0 z-10 w-screen overflow-y-auto">
    <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
      <div
        class="relative transform overflow-hidden rounded bg-white text-left shadow-2xl transition-all sm:my-8 sm:w-full sm:max-w-md border border-slate-200"
      >
        <div class="bg-white px-6 pb-6 pt-6">
          <div class="sm:flex sm:items-start">
            <div
              id="alertIconBg"
              class="mx-auto flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-red-50 sm:mx-0 ring-1 ring-inset ring-red-600/10"
            >
              <i id="alertIcon" data-lucide="alert-triangle" class="h-5 w-5 text-red-600"></i>
            </div>
            <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left flex-1">
              <h3
                class="text-xs font-bold text-slate-800 uppercase tracking-widest leading-6"
                id="alertTitle"
              >
                System Alert
              </h3>
              <div class="mt-1">
                <p class="text-xs text-slate-500 font-medium leading-relaxed" id="alertMessage">
                  Operation could not be completed at this time.
                </p>
              </div>
              <!-- Verification Input Area -->
              <div id="verifyArea" class="mt-5 hidden">
                <div class="p-3 bg-slate-50 rounded-lg border border-slate-100 italic-text-off">
                  <p
                    class="text-[10px] font-bold text-slate-500 tracking-widest mb-3"
                    id="verifyInstructions"
                  >
                    Identity Verification Required
                  </p>
                  <input
                    type="text"
                    id="verifyInput"
                    class="w-full px-3 py-2 bg-white border border-slate-200 rounded text-xs focus:outline-none focus:ring-1 focus:ring-red-500 transition-all font-bold placeholder:font-normal placeholder:text-slate-300"
                    placeholder="Type confirmation here..."
                    autocomplete="off"
                  />
                </div>
              </div>
            </div>
          </div>
        </div>
        <div
          class="bg-slate-50/50 px-6 py-4 sm:flex sm:flex-row-reverse gap-3 border-t border-slate-100"
        >
          <button
            type="button"
            id="alertConfirm"
            class="inline-flex w-full justify-center rounded px-4 py-2 text-[10px] font-bold text-white shadow-sm bg-slate-900 hover:bg-black sm:w-auto transition-all transform active:scale-95 disabled:opacity-30 disabled:cursor-not-allowed disabled:scale-100 uppercase tracking-widest"
          >
            Continue
          </button>
          <button
            type="button"
            id="alertCancel"
            class="mt-3 inline-flex w-full justify-center rounded bg-white px-4 py-2 text-[10px] font-bold text-slate-500 shadow-sm border border-slate-200 hover:bg-slate-50 sm:mt-0 sm:w-auto transition-colors hidden uppercase tracking-widest"
          >
            Cancel
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  window.customAlert = (() => {
    const modal = document.getElementById('customAlert');
    const titleEl = document.getElementById('alertTitle');
    const msgEl = document.getElementById('alertMessage');
    const confirmBtn = document.getElementById('alertConfirm');
    const cancelBtn = document.getElementById('alertCancel');
    const iconBg = document.getElementById('alertIconBg');
    const icon = document.getElementById('alertIcon');
    const verifyArea = document.getElementById('verifyArea');
    const verifyInput = document.getElementById('verifyInput');
    const verifyInstructions = document.getElementById('verifyInstructions');

    let resolvePromise;
    let expectedText = null;

    function show(title, message, type = 'error', showCancel = false, verifyText = null) {
      return new Promise((resolve) => {
        resolvePromise = resolve;
        expectedText = verifyText;

        titleEl.textContent = title;
        msgEl.textContent = message;

        // Reset verify area
        verifyArea.classList.toggle('hidden', !verifyText);
        verifyInput.value = '';
        if (verifyText) {
          verifyInstructions.textContent = `Type "${verifyText}" to confirm`;
          confirmBtn.disabled = true;
          verifyInput.oninput = (e) => {
            confirmBtn.disabled = e.target.value !== verifyText;
          };
        } else {
          confirmBtn.disabled = false;
          verifyInput.oninput = null;
        }

        // Style based on type
        if (type === 'success') {
          iconBg.className =
            'mx-auto flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-emerald-50 sm:mx-0 ring-1 ring-inset ring-emerald-600/10';
          icon.className = 'h-5 w-5 text-emerald-600';
          icon.setAttribute('data-lucide', 'check-circle');
          confirmBtn.className =
            'inline-flex w-full justify-center rounded bg-emerald-600 px-4 py-2 text-[10px] font-bold text-white shadow-sm hover:bg-emerald-700 sm:w-auto transition-all transform active:scale-95 disabled:opacity-30 disabled:cursor-not-allowed disabled:scale-100 uppercase tracking-widest';
        } else if (type === 'warning' || type === 'confirm') {
          iconBg.className =
            'mx-auto flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-amber-50 sm:mx-0 ring-1 ring-inset ring-amber-600/10';
          icon.className = 'h-5 w-5 text-amber-600';
          icon.setAttribute('data-lucide', 'alert-triangle');
          confirmBtn.className =
            'inline-flex w-full justify-center rounded bg-amber-600 px-4 py-2 text-[10px] font-bold text-white shadow-sm hover:bg-amber-700 sm:w-auto transition-all transform active:scale-95 disabled:opacity-30 disabled:cursor-not-allowed disabled:scale-100 uppercase tracking-widest';
        } else {
          // error
          iconBg.className =
            'mx-auto flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-red-50 sm:mx-0 ring-1 ring-inset ring-red-600/10';
          icon.className = 'h-5 w-5 text-red-600';
          icon.setAttribute('data-lucide', 'x-circle');
          confirmBtn.className =
            'inline-flex w-full justify-center rounded bg-red-600 px-4 py-2 text-[10px] font-bold text-white shadow-sm hover:bg-red-700 sm:w-auto transition-all transform active:scale-95 disabled:opacity-30 disabled:cursor-not-allowed disabled:scale-100 uppercase tracking-widest';
        }

        lucide.createIcons();

        cancelBtn.classList.toggle('hidden', !showCancel);
        confirmBtn.textContent = showCancel || verifyText ? 'Continue' : 'OK';

        modal.classList.remove('hidden');
        if (verifyText) setTimeout(() => verifyInput.focus(), 100);
      });
    }

    function close(result) {
      modal.classList.add('hidden');
      if (resolvePromise) resolvePromise(result);
    }

    confirmBtn.onclick = () => close(true);
    cancelBtn.onclick = () => close(false);

    return {
      alert: (title, message, type) => show(title, message, type, false),
      confirm: (title, message, type = 'warning') => show(title, message, type, true, null),
      verify: (title, message, textToVerify) => show(title, message, 'error', true, textToVerify),
    };
  })();

  window.showAlert = (message, type = 'error') =>
    window.customAlert.alert(
      type === 'error' ? 'System Notice' : 'Operation Success',
      message,
      type
    );

  window.showConfirm = (message) =>
    window.customAlert.confirm('Confirmation Required', message, 'confirm');

  window.showVerify = (message, textToVerify) =>
    window.customAlert.verify('Critical Security Override', message, textToVerify);
</script>
