<div class="max-w-7xl mx-auto space-y-6">
  <div class="pb-6 border-b border-slate-100 flex items-center justify-between">
    <div>
      <h2 class="text-lg font-bold text-slate-800">Notification Templates</h2>
      <p class="text-xs text-slate-500 mt-1">
        Reusable content structures for multi-channel messaging.
      </p>
    </div>
    <a
      href="/admin/templates/new"
      class="inline-flex items-center px-4 py-2 bg-slate-900 hover:bg-black text-white text-[10px] font-bold uppercase tracking-widest rounded transition-all gap-2"
    >
      <i data-lucide="plus" class="w-3.5 h-3.5"></i> New Template
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% if (templates && templates.length > 0) { %> <% templates.forEach(template => { %>
    <div
      class="bg-white border border-slate-200 rounded-lg p-6 shadow-sm hover:border-blue-200 transition-colors group relative"
    >
      <div class="flex items-start justify-between mb-4">
        <div class="p-2 bg-slate-50 rounded border border-slate-100">
          <% if(template.type === 'email') { %>
          <i data-lucide="mail" class="w-4 h-4 text-blue-500"></i>
          <% } else if(template.type === 'slack') { %>
          <i data-lucide="slack" class="w-4 h-4 text-purple-500"></i>
          <% } else { %>
          <i data-lucide="file-text" class="w-4 h-4 text-slate-400"></i>
          <% } %>
        </div>
        <div class="flex items-center gap-2">
          <% if (template.isPublished) { %>
          <span
            class="px-1.5 py-0.5 bg-emerald-50 text-emerald-600 text-[8px] font-bold uppercase rounded border border-emerald-100"
            >Published</span
          >
          <% } %>
          <a
            href="/admin/templates/<%= template._id %>/edit"
            class="p-1.5 text-slate-400 hover:text-blue-600 transition-colors"
          >
            <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
          </a>
          <button
            onclick="deleteTemplate('<%= template._id %>')"
            class="p-1.5 text-slate-400 hover:text-red-600 transition-colors"
          >
            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
          </button>
        </div>
      </div>
      <div>
        <h3 class="text-sm font-bold text-slate-800 mb-1"><%= template.name %></h3>
        <p class="text-[10px] text-slate-400 font-mono uppercase mb-4">
          <%= template.type %> gateway
        </p>
        <div class="flex items-center justify-between pt-4 border-t border-slate-50">
          <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest"
            >ID: <%= template._id.toString().slice(-6) %></span
          >
          <span class="text-[10px] text-slate-400"
            ><%= new Date(template.createdAt).toLocaleDateString() %></span
          >
        </div>
      </div>
    </div>
    <% }) %> <% } else { %>
    <div class="col-span-full py-20 text-center text-slate-400">
      <div class="flex flex-col items-center gap-3">
        <i data-lucide="file-code-2" class="w-10 h-10 text-slate-200"></i>
        <p class="text-xs lowercase">No templates defined.</p>
      </div>
    </div>
    <% } %>
  </div>
</div>

<script>
  async function deleteTemplate(id) {
    if (!(await showConfirm('Are you sure you want to delete this template?'))) return;
    try {
      const res = await fetch(`/admin/admin-api/templates/${id}`, { method: 'DELETE' });
      if (res.ok) {
        await showAlert('Template purged successfully', 'success');
        window.location.reload();
      } else {
        showAlert('Failed to delete template');
      }
    } catch (e) {
      showAlert('Network error');
    }
  }
  lucide.createIcons();
</script>
