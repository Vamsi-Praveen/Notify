<div class="max-w-7xl mx-auto space-y-6">
  <!-- Header -->
  <div class="pb-6 border-b border-slate-100 flex items-center justify-between">
    <div>
      <h2 class="text-lg font-bold text-slate-800">Delivery History</h2>
      <p class="text-xs text-slate-500 mt-1">
        Global history for all notification processing across the cluster.
      </p>
    </div>
    <div class="flex items-center gap-3">
      <a
        href="/admin/logs/export"
        class="inline-flex items-center px-4 py-2 bg-slate-900 hover:bg-black text-white text-[10px] font-bold uppercase tracking-widest rounded transition-all gap-2"
      >
        <i data-lucide="download" class="w-3.5 h-3.5"></i> Export CSV
      </a>
      <button
        onclick="window.location.reload()"
        class="p-2 border border-slate-200 rounded text-slate-400 hover:text-slate-600 hover:border-slate-300"
      >
        <i data-lucide="refresh-cw" class="w-4 h-4"></i>
      </button>
    </div>
  </div>

  <!-- Logs Table -->
  <div
    class="bg-white border border-slate-200 rounded-lg overflow-hidden shadow-sm italic-text-off"
  >
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead
          class="bg-slate-50/50 text-[10px] font-bold text-slate-500 uppercase tracking-widest border-b border-slate-100"
        >
          <tr>
            <th class="px-6 py-4">Time</th>
            <th class="px-6 py-4">Tenant</th>
            <th class="px-6 py-4">Workflow</th>
            <th class="px-6 py-4">Event</th>
            <th class="px-6 py-4">Status</th>
            <th class="px-6 py-4">Metadata</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (logs && logs.length > 0) { %> <% logs.forEach(log => { %>
          <tr class="hover:bg-slate-50/50 transition-colors">
            <td class="px-6 py-4 text-[10px] text-slate-400 font-medium whitespace-nowrap">
              <%= new Date(log.createdAt).toLocaleString() %>
            </td>
            <td
              class="px-6 py-4 text-xs font-bold text-slate-700 underline decoration-slate-200 decoration-dotted"
            >
              <%= log.tenantId?.name || '—' %>
            </td>
            <td class="px-6 py-4 text-xs text-slate-500"><%= log.workflowId?.name || '—' %></td>
            <td class="px-6 py-4 text-xs font-semibold text-slate-800"><%= log.eventName %></td>
            <td class="px-6 py-4">
              <span
                class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold uppercase border <%= log.status === 'SENT' || log.status === 'DELIVERED' ? 'bg-emerald-50 text-emerald-700 border-emerald-100' : log.status === 'FAILED' ? 'bg-red-50 text-red-700 border-red-100' : 'bg-blue-50 text-blue-700 border-blue-100' %>"
              >
                <%= log.status %>
              </span>
            </td>
            <td class="px-6 py-4">
              <span
                class="text-[10px] text-slate-400 font-mono underline decoration-dotted decoration-slate-200 cursor-help"
                title="<%= JSON.stringify(log.metadata || {}) %>"
              >
                inspect meta
              </span>
            </td>
          </tr>
          <% }) %> <% } else { %>
          <tr>
            <td colspan="6" class="px-6 py-20 text-center text-slate-400">
              <div class="flex flex-col items-center gap-3">
                <i data-lucide="scroll-text" class="w-10 h-10 text-slate-200"></i>
                <p class="text-xs lowercase">Log stream is currently empty.</p>
              </div>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  lucide.createIcons();
</script>
