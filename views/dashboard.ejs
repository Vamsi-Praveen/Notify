<div class="max-w-7xl mx-auto space-y-8">
  <!-- Stats Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-white p-5 border border-slate-200 rounded-lg shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest leading-none"
          >Total Notifications</span
        >
        <i data-lucide="bar-chart-2" class="w-4 h-4 text-blue-500"></i>
      </div>
      <div class="text-2xl font-bold text-slate-900">
        <%= (stats.totalNotifications || 0).toLocaleString() %>
      </div>
    </div>

    <div class="bg-white p-5 border border-slate-200 rounded-lg shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest leading-none"
          >Active Tenants</span
        >
        <i data-lucide="users" class="w-4 h-4 text-emerald-500"></i>
      </div>
      <div class="text-2xl font-bold text-slate-900"><%= stats.tenants || 0 %></div>
    </div>

    <div class="bg-white p-5 border border-slate-200 rounded-lg shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest leading-none"
          >Compute Units</span
        >
        <i data-lucide="git-branch" class="w-4 h-4 text-purple-500"></i>
      </div>
      <div class="text-2xl font-bold text-slate-900"><%= stats.workflows || 0 %></div>
      <p class="text-[8px] font-medium text-slate-400 uppercase mt-1">Active Workflows</p>
    </div>

    <div class="bg-white p-5 border border-slate-200 rounded-lg shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest leading-none"
          >Cluster Health</span
        >
        <i data-lucide="activity" class="w-4 h-4 text-emerald-500"></i>
      </div>
      <div class="flex flex-col gap-1">
        <div class="flex items-center justify-between">
          <span class="text-[8px] font-bold text-slate-400 uppercase">Database</span>
          <span
            class="text-[10px] font-bold <%= stats.status === 'Healthy' ? 'text-emerald-600' : 'text-red-600' %> uppercase"
            ><%= stats.status %></span
          >
        </div>
        <div class="flex items-center justify-between">
          <span class="text-[8px] font-bold text-slate-400 uppercase">Redis Queue</span>
          <span
            class="text-[10px] font-bold <%= stats.redis === 'Healthy' ? 'text-emerald-600' : 'text-red-600' %> uppercase"
            ><%= stats.redis %></span
          >
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Recent Logs Table -->
    <div
      class="lg:col-span-2 border border-slate-200 rounded-lg bg-white overflow-hidden shadow-sm"
    >
      <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
        <h3 class="text-xs font-bold text-slate-800 uppercase tracking-widest">
          Global Activity Feed
        </h3>
        <a
          href="/admin/logs"
          class="text-[10px] font-bold text-blue-600 hover:text-blue-700 uppercase tracking-widest"
          >Master Logs &rarr;</a
        >
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-50/50 border-b border-slate-100">
            <tr>
              <th class="px-6 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest">
                Tenant
              </th>
              <th class="px-6 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest">
                Event
              </th>
              <th class="px-6 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest">
                Status
              </th>
              <th class="px-6 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest">
                Time
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (recentActivity && recentActivity.length > 0) { recentActivity.forEach(log => { %>
            <tr class="hover:bg-slate-50/50 transition-colors text-xs">
              <td class="px-6 py-4">
                <span
                  class="font-bold text-slate-700 underline decoration-slate-200 decoration-dotted"
                  ><%= log.tenantId?.name || 'Unknown' %></span
                >
              </td>
              <td class="px-6 py-4 text-slate-800 font-medium"><%= log.eventName %></td>
              <td class="px-6 py-4">
                <span
                  class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold uppercase border <%= log.status === 'SENT' || log.status === 'DELIVERED' ? 'bg-emerald-50 text-emerald-700 border-emerald-100' : log.status === 'FAILED' ? 'bg-red-50 text-red-700 border-red-100' : 'bg-blue-50 text-blue-700 border-blue-100' %>"
                >
                  <%= log.status %>
                </span>
              </td>
              <td class="px-6 py-4 text-slate-400 text-[10px]">
                <%= new Date(log.createdAt).toLocaleTimeString() %>
              </td>
            </tr>
            <% }) %> <% } else { %>
            <tr>
              <td colspan="4" class="px-6 py-10 text-center text-slate-400 text-xs">
                Waiting for events...
              </td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Quick Integration Shortcuts -->
    <div class="space-y-6">
      <div class="border rounded-lg p-6 bg-white shadow-sm border-slate-200">
        <h3
          class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-4 flex items-center gap-2"
        >
          <i data-lucide="shield-check" class="w-3.5 h-3.5 text-blue-500"></i>
          Platform Readiness
        </h3>
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-bold text-slate-500 uppercase tracking-tight"
              >Main SMTP Gateway</span
            >
            <% if (config.smtp && config.smtp.host && config.smtp.userName) { %>
            <span
              class="text-[9px] font-bold text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-100 uppercase"
              >Ready</span
            >
            <% } else { %>
            <span
              class="text-[9px] font-bold text-red-600 bg-red-50 px-1.5 py-0.5 rounded border border-red-100 uppercase"
              >Missing</span
            >
            <% } %>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-bold text-slate-500 uppercase tracking-tight"
              >Slack Integration</span
            >
            <% if (config.slack && config.slack.isActive && config.slack.slackBotToken) { %>
            <span
              class="text-[9px] font-bold text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-100 uppercase"
              >Active</span
            >
            <% } else { %>
            <span
              class="text-[9px] font-bold text-slate-400 bg-slate-50 px-1.5 py-0.5 rounded border border-slate-100 uppercase"
              >Optional</span
            >
            <% } %>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-bold text-slate-500 uppercase tracking-tight"
              >SMS (Twilio) Cluster</span
            >
            <% if (config.sms && config.sms.twilio && config.sms.twilio.accountSid) { %>
            <span
              class="text-[9px] font-bold text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-100 uppercase"
              >Linked</span
            >
            <% } else { %>
            <span
              class="text-[9px] font-bold text-slate-400 bg-slate-50 px-1.5 py-0.5 rounded border border-slate-100 uppercase"
              >Optional</span
            >
            <% } %>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-bold text-slate-500 uppercase tracking-tight"
              >Firebase Push Hook</span
            >
            <% if (config.pushNotification && config.pushNotification.firebase &&
            config.pushNotification.firebase.apiKey) { %>
            <span
              class="text-[9px] font-bold text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-100 uppercase"
              >Linked</span
            >
            <% } else { %>
            <span
              class="text-[9px] font-bold text-slate-400 bg-slate-50 px-1.5 py-0.5 rounded border border-slate-100 uppercase"
              >Optional</span
            >
            <% } %>
          </div>
        </div>
        <div class="mt-6 pt-6 border-t border-slate-100">
          <a
            href="/admin/system-config"
            class="w-full py-2 bg-slate-900 hover:bg-black text-white text-[10px] font-bold uppercase tracking-widest rounded flex items-center justify-center gap-2 transition-all"
          >
            Configure Infrastructure
            <i data-lucide="chevron-right" class="w-3 h-3"></i>
          </a>
        </div>
      </div>

      <div class="border rounded-lg p-6 bg-white shadow-sm border-slate-200">
        <h3 class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-4">
          Quick Setup
        </h3>
        <div class="space-y-3">
          <a href="/admin/tenants/new" class="flex items-center justify-between p-3 rounded group">
            <span class="text-xs font-bold text-slate-500">Register New Tenant</span>
            <i data-lucide="plus" class="w-4 h-4 text-slate-500"></i>
          </a>
          <a
            href="/admin/templates/new"
            class="flex items-center justify-between p-3 rounded group"
          >
            <span class="text-xs font-bold text-slate-500">Draft Notification Template</span>
            <i data-lucide="plus" class="w-4 h-4 text-slate-500"></i>
          </a>
          <a href="/admin/system-config" class="flex items-center justify-between p-3 rounded">
            <span class="text-xs font-bold text-slate-500">Cluster Settings</span>
            <i data-lucide="settings" class="w-4 h-4 text-slate-500"></i>
          </a>
        </div>
      </div>

      <div class="bg-white border border-slate-200 rounded-lg p-6 shadow-sm">
        <h3 class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-4">
          Worker Load
        </h3>
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs text-slate-600 font-medium">Queue Status</span>
            <span
              class="text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100 uppercase tracking-widest"
              >Active</span
            >
          </div>
          <div class="w-full bg-slate-100 h-1.5 rounded-full overflow-hidden">
            <div class="bg-blue-600 h-full w-[15%]"></div>
          </div>
          <p class="text-[10px] text-slate-400 font-medium">
            Processing 12 messages/minute average.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  lucide.createIcons();
</script>
