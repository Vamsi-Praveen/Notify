<div class="max-w-7xl mx-auto space-y-6">
  <!-- Header -->
  <div class="pb-6 border-b border-slate-100 flex items-center justify-between">
    <div>
      <h2 class="text-lg font-bold text-slate-800">Delivery History</h2>
      <p class="text-xs text-slate-500 mt-1">
        Detailed history of all notification traffic for your tenant.
      </p>
    </div>
    <div class="flex items-center gap-3">
      <a
        href="/tenant/logs/export"
        class="inline-flex items-center px-4 py-2 bg-slate-900 hover:bg-black text-white text-[10px] font-bold uppercase tracking-widest rounded transition-all gap-2"
      >
        <i data-lucide="download" class="w-3.5 h-3.5"></i> Download CSV
      </a>
      <button
        onclick="window.location.reload()"
        class="p-2 border border-slate-200 rounded text-slate-400 hover:text-slate-600 hover:border-slate-300"
      >
        <i data-lucide="refresh-cw" class="w-4 h-4"></i>
      </button>
    </div>
  </div>

  <!-- Logs Table -->
  <div class="bg-white border border-slate-200 rounded-lg overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead
          class="bg-slate-50/50 text-[10px] font-bold text-slate-500 uppercase tracking-widest border-b border-slate-100"
        >
          <tr>
            <th class="px-6 py-4">Time</th>
            <th class="px-6 py-4">Workflow</th>
            <th class="px-6 py-4">Event Identifier</th>
            <th class="px-6 py-4">Channel Out</th>
            <th class="px-6 py-4">Current Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (logs && logs.length > 0) { %> <% logs.forEach(log => { %>
          <tr class="hover:bg-slate-50/50 transition-colors text-xs">
            <td class="px-6 py-4 text-[10px] text-slate-400 font-medium">
              <%= new Date(log.createdAt).toLocaleString() %>
            </td>
            <td class="px-6 py-4 text-slate-500"><%= log.workflowId?.name || '—' %></td>
            <td class="px-6 py-4 font-bold text-slate-800"><%= log.eventName %></td>
            <td class="px-6 py-4">
              <span
                class="inline-flex items-center px-1.5 py-0.5 rounded border border-slate-100 bg-slate-50 text-[10px] font-bold text-slate-600 uppercase"
              >
                <%= log.channel || 'pending' %>
              </span>
            </td>
            <td class="px-6 py-4">
              <span
                class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold uppercase border <%= log.status === 'SENT' || log.status === 'DELIVERED' ? 'bg-emerald-50 text-emerald-700 border-emerald-100' : log.status === 'FAILED' ? 'bg-red-50 text-red-700 border-red-100' : 'bg-blue-50 text-blue-700 border-blue-100' %>"
              >
                <%= log.status %>
              </span>
            </td>
          </tr>
          <% }) %> <% } else { %>
          <tr>
            <td colspan="5" class="px-6 py-12 text-center text-slate-400 lowercase text-xs">
              Log stream is currently empty.
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  lucide.createIcons();
</script>
