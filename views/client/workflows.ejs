<div class="max-w-7xl mx-auto space-y-6">
  <div class="pb-6 border-b border-slate-100 flex items-center justify-between">
    <div>
      <h2 class="text-lg font-bold text-slate-800">Workflows</h2>
      <p class="text-xs text-slate-500 mt-1">
        Manage how events trigger notification templates and integrations.
      </p>
    </div>
    <a
      href="/tenant/workflows/new"
      class="inline-flex items-center px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-[10px] font-bold uppercase tracking-widest rounded shadow-sm transition-all gap-2"
    >
      <i data-lucide="plus" class="w-3.5 h-3.5"></i> Create Workflow
    </a>
  </div>

  <div class="bg-white border border-slate-200 rounded-lg overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead
          class="bg-slate-50/50 text-[10px] font-bold text-slate-500 uppercase tracking-widest border-b border-slate-100"
        >
          <tr>
            <th class="px-6 py-4">Workflow Name</th>
            <th class="px-6 py-4">Scope</th>
            <th class="px-6 py-4">Trigger Event</th>
            <th class="px-6 py-4">Template</th>
            <th class="px-6 py-4">Integration</th>
            <th class="px-6 py-4">Status</th>
            <th class="px-6 py-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (workflows && workflows.length > 0) { %> <% workflows.forEach(workflow => { %>
          <tr class="hover:bg-slate-50/50 transition-colors">
            <td class="px-6 py-4">
              <div class="text-xs font-bold text-slate-800">
                <%= workflow.name || 'Untitled Flow' %>
              </div>
              <div class="text-[10px] text-slate-400 font-mono uppercase">
                ID: <%= workflow._id.toString().slice(-6) %>
              </div>
            </td>
            <td class="px-6 py-4">
              <% if (!workflow.tenantId) { %>
              <span
                class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-blue-50 text-blue-600 border border-blue-100"
              >
                All Tenants
              </span>
              <p class="text-[9px] text-slate-400 mt-1 italic tracking-tight font-medium">
                System-wide workflow
              </p>
              <% } else { %>
              <span
                class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-slate-50 text-slate-500 border border-slate-200"
              >
                My Tenant
              </span>
              <p class="text-[9px] text-slate-400 mt-1 italic tracking-tight font-medium">
                Workflow specific to my tenant
              </p>
              <% } %>
            </td>
            <td class="px-6 py-4 text-xs font-medium text-slate-600">
              <span
                class="bg-blue-50 text-blue-700 px-1.5 py-0.5 border border-blue-100 rounded-md font-bold uppercase text-[9px]"
                ><%= workflow.triggerEvent %></span
              >
            </td>
            <td class="px-6 py-4 text-xs text-slate-500">
              <% if (workflow.actions && workflow.actions.length > 0) { %>
              <div class="space-y-1">
                <% workflow.actions.forEach((action, i) => { %>
                <div class="<%= i > 0 ? 'pt-1 border-t border-slate-50' : '' %>">
                  <%= action.template?.name || '—' %>
                </div>
                <% }) %>
              </div>
              <% } else { %> — <% } %>
            </td>
            <td class="px-6 py-4">
              <% if (workflow.actions && workflow.actions.length > 0) { %>
              <div class="space-y-1">
                <% workflow.actions.forEach((action, i) => { %>
                <div class="<%= i > 0 ? 'pt-1 border-t border-slate-50' : '' %>">
                  <span
                    class="text-[10px] font-bold text-slate-500 uppercase bg-slate-100 px-1.5 py-0.5 rounded border border-slate-200"
                  >
                    <%= action.integration?.name || 'Auto System' %>
                  </span>
                </div>
                <% }) %>
              </div>
              <% } else { %>
              <span class="text-[10px] font-bold text-slate-400 uppercase italic"
                >Not configured</span
              >
              <% } %>
            </td>
            <td class="px-6 py-4">
              <span
                class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold uppercase border <%= workflow.active !== false ? 'bg-emerald-50 text-emerald-700 border-emerald-100' : 'bg-slate-100 text-slate-400 border-slate-200' %>"
              >
                <%= workflow.active !== false ? 'Active' : 'Inactive' %>
              </span>
            </td>
            <td class="px-6 py-4 text-right">
              <div class="flex items-center justify-end gap-2">
                <% if (workflow.tenantId) { %>
                <a
                  href="/tenant/workflows/<%= workflow._id %>/edit"
                  class="p-1.5 text-slate-400 hover:text-blue-600 transition-colors border border-slate-100 rounded hover:bg-white shadow-sm"
                >
                  <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                </a>
                <button
                  onclick="deleteWorkflow('<%= workflow._id %>')"
                  class="p-1.5 text-slate-400 hover:text-red-600 transition-colors border border-slate-100 rounded hover:bg-white shadow-sm"
                >
                  <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                </button>
                <% } else { %>
                <span class="text-[10px] text-slate-400 font-bold uppercase italic px-2"
                  >Read Only</span
                >
                <% } %>
              </div>
            </td>
          </tr>
          <% }) %> <% } else { %>
          <tr>
            <td colspan="6" class="px-6 py-20 text-center text-slate-400">
              <div class="flex flex-col items-center gap-3">
                <i data-lucide="git-merge" class="w-12 h-12 text-slate-200"></i>
                <p class="text-xs font-bold uppercase tracking-widest text-slate-300">
                  No workflows found.
                </p>
                <a
                  href="/tenant/workflows/new"
                  class="text-blue-500 text-[10px] font-bold uppercase hover:underline"
                  >Create your first workflow</a
                >
              </div>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  async function deleteWorkflow(id) {
    if (!(await showConfirm('Are you sure you want to delete this workflow?'))) return;
    try {
      const res = await fetch(`/tenant-api/workflows/${id}`, { method: 'DELETE' });
      if (res.ok) {
        await showAlert('Workflow deleted', 'success');
        window.location.reload();
      } else {
        const err = await res.json();
        showAlert(err.message || 'Delete failed');
      }
    } catch (e) {
      showAlert('Network error');
    }
  }
  lucide.createIcons();
</script>
