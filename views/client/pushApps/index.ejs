<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-lg font-bold text-slate-800">Mobile Apps</h2>
      <p class="text-xs text-slate-500 mt-1">
        Manage your mobile applications and Firebase credentials.
      </p>
    </div>
    <a
      href="/tenant/push-apps/new"
      class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold uppercase tracking-widest rounded-lg shadow-sm transition-colors"
    >
      <i data-lucide="plus" class="w-4 h-4"></i>
      Add App
    </a>
  </div>

  <!-- Apps List -->
  <div class="grid gap-4">
    <% if (apps && apps.length > 0) { %>
    <div class="bg-white border border-slate-200 rounded-lg overflow-hidden shadow-sm">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 border-b border-slate-100">
          <tr>
            <th class="px-6 py-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest">
              Name
            </th>
            <th class="px-6 py-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest">
              App ID
            </th>
            <th class="px-6 py-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest">
              Platform
            </th>
            <th class="px-6 py-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest">
              Status
            </th>
            <th
              class="px-6 py-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest text-right"
            >
              Actions
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% apps.forEach(app => { %>
          <tr class="hover:bg-slate-50/50 transition-colors">
            <td class="px-6 py-4 font-medium text-slate-800"><%= app.name %></td>
            <td class="px-6 py-4 text-slate-600 font-mono text-xs"><%= app.appId %></td>
            <td class="px-6 py-4">
              <div class="flex items-center gap-2">
                <% if (app.platform === 'android' || app.platform === 'both') { %>
                <span
                  class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-green-100 text-green-800 uppercase"
                  >Android</span
                >
                <% } %> <% if (app.platform === 'ios' || app.platform === 'both') { %>
                <span
                  class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-slate-100 text-slate-800 uppercase"
                  >iOS</span
                >
                <% } %>
              </div>
            </td>
            <td class="px-6 py-4">
              <% if (app.isActive) { %>
              <span
                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-green-50 text-green-700 border border-green-100"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span>
                Active
              </span>
              <% } else { %>
              <span
                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-slate-50 text-slate-600 border border-slate-200"
              >
                <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>
                Inactive
              </span>
              <% } %>
            </td>
            <td class="px-6 py-4 text-right">
              <div class="flex items-center justify-end gap-2">
                <a
                  href="/tenant/push-apps/<%= app._id %>/edit"
                  class="p-2 text-slate-400 hover:text-blue-600 hover:bg-blue-50 rounded transition-colors"
                  title="Edit"
                >
                  <i data-lucide="edit-2" class="w-4 h-4"></i>
                </a>
                <button
                  onclick="deleteApp('<%= app._id %>', this)"
                  class="p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded transition-colors"
                  title="Delete"
                >
                  <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="text-center py-20 bg-slate-50 rounded-lg border-2 border-dashed border-slate-200">
      <div
        class="w-16 h-16 bg-slate-100/50 rounded-full flex items-center justify-center mx-auto mb-4"
      >
        <i data-lucide="smartphone" class="w-8 h-8 text-slate-400"></i>
      </div>
      <h3 class="text-sm font-medium text-slate-900">No apps configured</h3>
      <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">
        Add your mobile applications to manage push notification credentials.
      </p>
      <a
        href="/tenant/push-apps/new"
        class="inline-flex items-center gap-2 mt-6 px-4 py-2 bg-slate-900 text-white text-xs font-bold uppercase tracking-widest rounded hover:bg-slate-800 transition-all"
      >
        <i data-lucide="plus" class="w-4 h-4"></i>
        Setup First App
      </a>
    </div>
    <% } %>
  </div>
</div>

<script>
  async function deleteApp(id, btn) {
    if (!confirm('Are you sure you want to delete this app? This action cannot be undone.')) return;

    toggleLoading(btn, true, '');

    try {
      const response = await fetch(`/tenant-api/push-apps/${id}`, {
        method: 'DELETE',
      });

      if (response.ok) {
        window.location.reload();
      } else {
        const data = await response.json();
        alert(data.message || 'Failed to delete app');
        toggleLoading(btn, false);
      }
    } catch (error) {
      console.error('Error:', error);
      alert('An error occurred while deleting the app');
      toggleLoading(btn, false);
    }
  }
</script>
