<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> - Tenant Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
      body {
        font-family: 'Inter', sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      .sidebar-link-active {
        background-color: #1e293b;
        color: #f8fafc;
      }
      /* Hide scrollbar */
      * {
        scrollbar-width: none;
        -ms-overflow-style: none;
      }
      *::-webkit-scrollbar {
        display: none;
      }
    </style>
  </head>
  <body class="h-full flex overflow-hidden">
    <!-- Sidebar -->
    <aside
      class="w-64 bg-slate-900 border-r border-slate-800 flex-shrink-0 hidden lg:flex flex-col"
    >
      <div class="h-16 flex items-center px-6 border-b border-slate-800">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 bg-blue-600 rounded flex items-center justify-center">
            <i data-lucide="bell" class="w-5 h-5 text-white"></i>
          </div>
          <span class="text-white font-bold">Notification Service</span>
        </div>
      </div>

      <nav class="flex-1 p-4 space-y-1 overflow-y-auto">
        <a
          href="/dashboard"
          class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md transition-colors <%= path === '/dashboard' ? 'sidebar-link-active' : 'text-slate-400 hover:text-white hover:bg-slate-800' %>"
        >
          <i data-lucide="grid" class="w-4 h-4"></i>
          Dashboard
        </a>

        <div class="pt-4 pb-2 px-3">
          <span class="text-[10px] font-bold text-slate-500 uppercase tracking-widest"
            >Resources</span
          >
        </div>

        <a
          href="/tenant/push-apps"
          class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md transition-colors <%= path.startsWith('/tenant/push-apps') ? 'sidebar-link-active' : 'text-slate-400 hover:text-white hover:bg-slate-800' %>"
        >
          <i data-lucide="smartphone" class="w-4 h-4"></i>
          Mobile Apps
        </a>

        <a
          href="/tenant/api-keys"
          class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md transition-colors <%= path.startsWith('/tenant/api-keys') ? 'sidebar-link-active' : 'text-slate-400 hover:text-white hover:bg-slate-800' %>"
        >
          <i data-lucide="key" class="w-4 h-4"></i>
          API Keys
        </a>

        <a
          href="/tenant/templates"
          class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md transition-colors <%= path.startsWith('/tenant/templates') ? 'sidebar-link-active' : 'text-slate-400 hover:text-white hover:bg-slate-800' %>"
        >
          <i data-lucide="file-code" class="w-4 h-4"></i>
          Templates
        </a>

        <a
          href="/tenant/workflows"
          class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md transition-colors <%= path.startsWith('/tenant/workflows') ? 'sidebar-link-active' : 'text-slate-400 hover:text-white hover:bg-slate-800' %>"
        >
          <i data-lucide="git-branch" class="w-4 h-4"></i>
          Workflows
        </a>

        <a
          href="/tenant/integrations"
          class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md transition-colors <%= path.startsWith('/tenant/integrations') ? 'sidebar-link-active' : 'text-slate-400 hover:text-white hover:bg-slate-800' %>"
        >
          <i data-lucide="plug-2" class="w-4 h-4"></i>
          Integrations
        </a>

        <a
          href="/tenant/logs"
          class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md transition-colors <%= path.startsWith('/tenant/logs') ? 'sidebar-link-active' : 'text-slate-400 hover:text-white hover:bg-slate-800' %>"
        >
          <i data-lucide="file-text" class="w-4 h-4"></i>
          Activity Logs
        </a>

        <a
          href="/tenant/settings"
          class="flex items-center gap-3 px-3 py-2 text-sm font-medium rounded-md transition-colors <%= path.startsWith('/tenant/settings') ? 'sidebar-link-active' : 'text-slate-400 hover:text-white hover:bg-slate-800' %>"
        >
          <i data-lucide="settings" class="w-4 h-4"></i>
          Settings
        </a>
      </nav>

      <div class="p-4 border-t border-slate-800 bg-slate-900/50">
        <div class="flex items-center gap-3 mb-4">
          <div
            class="w-8 h-8 rounded-full bg-slate-700 flex items-center justify-center text-xs font-bold text-white uppercase border border-slate-600"
          >
            <%= tenant.name.substring(0, 2) %>
          </div>
          <div class="min-w-0 flex-1">
            <p class="text-xs font-semibold text-white truncate"><%= tenant.name %></p>
            <p class="text-[10px] text-slate-500 truncate"><%= tenant.email %></p>
          </div>
        </div>
        <a
          href="/logout"
          class="flex items-center justify-center gap-2 px-3 py-1.5 text-[10px] font-bold text-red-500 hover:text-red-400 hover:bg-red-500/10 rounded border border-red-500/20 hover:border-red-500/40 transition-all uppercase tracking-widest"
        >
          <i data-lucide="power" class="w-3 h-3"></i>
          Logout
        </a>
      </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden bg-white relative">
      <%- include('../partials/preloader') %>
      <!-- Header / Mobile Nav Placeholder -->
      <header
        class="h-16 border-b border-slate-100 flex items-center justify-between px-8 bg-white/80 backdrop-blur shrink-0"
      >
        <h1 class="text-sm font-bold text-slate-800 uppercase tracking-wider"><%= title %></h1>
        <div class="flex items-center gap-4 relative">
          <span
            class="text-[10px] font-bold text-slate-400 bg-slate-50 px-2 py-1 rounded border border-slate-100 uppercase capitalize"
            >Tenant Portal</span
          >

          <!-- Notification Button -->
          <button
            id="notifToggle"
            class="p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-50 rounded-full transition-colors relative"
          >
            <i data-lucide="bell" class="w-5 h-5"></i>
            <span
              class="absolute top-2 right-2 w-2 h-2 bg-blue-600 rounded-full border-2 border-white"
            ></span>
          </button>

          <!-- Notification Popup -->
          <div
            id="notifPopup"
            class="hidden absolute right-0 top-12 w-80 bg-white border border-slate-200 rounded-lg shadow-xl z-50 overflow-hidden"
          >
            <div
              class="px-4 py-3 border-b border-slate-100 bg-slate-50/50 flex items-center justify-between"
            >
              <span class="text-[10px] font-bold text-slate-500 uppercase tracking-widest"
                >Personal Alerts</span
              >
              <button class="text-[10px] font-bold text-blue-600 hover:underline uppercase">
                Clear
              </button>
            </div>
            <div class="max-h-64 overflow-y-auto divide-y divide-slate-50 text-left">
              <div class="px-4 py-3 hover:bg-slate-50 transition-colors">
                <p class="text-xs text-slate-800 font-semibold mb-0.5">Campaign Dispatched</p>
                <p class="text-[10px] text-slate-500">
                  Your monthly newsletter was sent to 450 recipients.
                </p>
                <span class="text-[9px] text-slate-400 mt-1 block">15 mins ago</span>
              </div>
              <div class="px-4 py-3 hover:bg-slate-50 transition-colors">
                <p class="text-xs text-slate-800 font-semibold mb-0.5">API Key Rotation</p>
                <p class="text-[10px] text-slate-500">Production key was updated successfully.</p>
                <span class="text-[9px] text-slate-400 mt-1 block">Yesterday</span>
              </div>
            </div>
            <div class="px-4 py-2 border-t border-slate-100 bg-slate-50/30 text-center">
              <a
                href="/tenant/logs"
                class="text-[10px] font-bold text-slate-400 hover:text-slate-600 uppercase tracking-widest"
                >View History</a
              >
            </div>
          </div>
        </div>
      </header>

      <main class="flex-1 overflow-y-auto p-8"><%- include(body) %></main>
    </div>

    <%- include('../partials/alert') %>

    <script>
      lucide.createIcons();

      // Notification Toggle
      const notifToggle = document.getElementById('notifToggle');
      const notifPopup = document.getElementById('notifPopup');

      if (notifToggle && notifPopup) {
        notifToggle.addEventListener('click', (e) => {
          e.stopPropagation();
          notifPopup.classList.toggle('hidden');
        });

        document.addEventListener('click', (e) => {
          if (!notifPopup.contains(e.target)) {
            notifPopup.classList.add('hidden');
          }
        });
      }

      // Global Loading Helper
      window.toggleLoading = function (button, isLoading, loadingText = 'Processing...') {
        if (!button) return;
        if (isLoading) {
          button.dataset.originalText = button.innerHTML;
          button.disabled = true;
          button.classList.add('opacity-75', 'cursor-not-allowed');
          button.innerHTML = `<svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> ${loadingText}`;
        } else {
          button.disabled = false;
          button.classList.remove('opacity-75', 'cursor-not-allowed');
          if (button.dataset.originalText) {
            button.innerHTML = button.dataset.originalText;
          }
        }
      };
    </script>
  </body>
</html>
