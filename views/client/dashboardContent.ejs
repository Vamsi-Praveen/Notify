<div class="max-w-7xl mx-auto space-y-8">
  <!-- Stats Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-white p-5 border border-slate-200 rounded-lg shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest leading-none"
          >Total Requests</span
        >
        <i data-lucide="bar-chart-2" class="w-4 h-4 text-blue-500"></i>
      </div>
      <div class="text-2xl font-bold text-slate-900"><%= stats.total %></div>
    </div>

    <div class="bg-white p-5 border border-slate-200 rounded-lg shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest leading-none"
          >Delivered</span
        >
        <i data-lucide="check-circle" class="w-4 h-4 text-emerald-500"></i>
      </div>
      <div class="text-2xl font-bold text-slate-900"><%= stats.sent %></div>
    </div>

    <div class="bg-white p-5 border border-slate-200 rounded-lg shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest leading-none"
          >Failed</span
        >
        <i data-lucide="alert-triangle" class="w-4 h-4 text-red-500"></i>
      </div>
      <div class="text-2xl font-bold text-slate-900"><%= stats.failed %></div>
    </div>

    <div class="bg-white p-5 border border-slate-200 rounded-lg shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest leading-none"
          >Pending</span
        >
        <i data-lucide="clock" class="w-4 h-4 text-amber-500"></i>
      </div>
      <div class="text-2xl font-bold text-slate-900"><%= stats.pending %></div>
    </div>
  </div>

  <!-- Recent Logs Table -->
  <div class="border border-slate-200 rounded-lg bg-white overflow-hidden shadow-sm">
    <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
      <h3 class="text-xs font-bold text-slate-800 uppercase tracking-widest">
        Recent Delivery Activity
      </h3>
      <a
        href="/tenant/logs"
        class="text-[10px] font-bold text-blue-600 hover:text-blue-700 uppercase tracking-widest"
        >View History &rarr;</a
      >
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50/50 border-b border-slate-100">
          <tr>
            <th class="px-6 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest">
              Event
            </th>
            <th class="px-6 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest">
              Workflow
            </th>
            <th class="px-6 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest">
              Status
            </th>
            <th class="px-6 py-3 text-[10px] font-bold text-slate-500 uppercase tracking-widest">
              Timestamp
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (recentLogs && recentLogs.length > 0) { %> <% recentLogs.forEach(log => { %>
          <tr class="hover:bg-slate-50/50 transition-colors">
            <td class="px-6 py-4">
              <div class="text-xs font-semibold text-slate-800"><%= log.eventName %></div>
            </td>
            <td class="px-6 py-4 text-slate-500">
              <div class="text-xs"><%= log.workflowId?.name || '---' %></div>
            </td>
            <td class="px-6 py-4">
              <span
                class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold uppercase border <%= log.status === 'SENT' || log.status === 'DELIVERED' ? 'bg-emerald-50 text-emerald-700 border-emerald-100' : log.status === 'FAILED' ? 'bg-red-50 text-red-700 border-red-100' : 'bg-blue-50 text-blue-700 border-blue-100' %>"
              >
                <%= log.status %>
              </span>
            </td>
            <td class="px-6 py-4 text-slate-400">
              <div class="text-[10px]"><%= new Date(log.createdAt).toLocaleString() %></div>
            </td>
          </tr>
          <% }) %> <% } else { %>
          <tr>
            <td colspan="4" class="px-6 py-10 text-center text-slate-400 text-xs">
              No recent activity detected.
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  lucide.createIcons();
</script>
