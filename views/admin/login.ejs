<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - Admin Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
      body {
        font-family: 'Inter', sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      * {
        scrollbar-width: none;
        -ms-overflow-style: none;
      }
      *::-webkit-scrollbar {
        display: none;
      }
    </style>
  </head>
  <body class="h-full flex flex-col items-center justify-center p-6 bg-slate-800">
    <%- include('../partials/preloader') %>
    <div class="w-full max-w-sm">
      <div class="bg-white rounded shadow-xl border border-slate-200 overflow-hidden">
        <div class="p-8">
          <div class="flex justify-center mb-6">
            <div class="w-12 h-12 bg-blue-600 rounded flex items-center justify-center shadow-lg">
              <i data-lucide="shield-check" class="w-7 h-7 text-white"></i>
            </div>
          </div>

          <div class="text-center mb-8">
            <h1 class="text-xl font-bold text-slate-800">Admin Login</h1>
            <p class="text-xs text-slate-500 mt-1.5 uppercase tracking-widest font-semibold">
              Authorized Infrastructure Access
            </p>
          </div>

          <% if (error) { %>
          <div
            class="mb-6 p-3 bg-red-50 border border-red-100 text-red-600 text-[10px] font-bold uppercase tracking-widest rounded flex items-center gap-2"
          >
            <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i>
            <%= error %>
          </div>
          <% } %>

          <form action="/admin/login" method="POST" class="space-y-4" id="loginForm">
            <div>
              <label
                class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1.5"
                for="email"
                >Email</label
              >
              <input
                type="email"
                name="email"
                id="email"
                required
                class="w-full px-4 py-2.5 rounded border border-slate-200 focus:border-blue-600 focus:ring-0 outline-none transition-colors text-sm"
                placeholder="admin@internal"
              />
            </div>

            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label
                  class="block text-[10px] font-bold text-slate-500 uppercase tracking-widest"
                  for="password"
                  >Password</label
                >
              </div>
              <input
                type="password"
                name="password"
                id="password"
                required
                placeholder="*********"
                class="w-full px-4 py-2.5 rounded border border-slate-200 focus:border-blue-600 focus:ring-0 outline-none transition-colors text-sm"
              />
            </div>

            <button
              type="submit"
              id="loginBtn"
              class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs uppercase tracking-widest rounded shadow-sm transition-all flex items-center justify-center gap-2"
            >
              Login
              <i data-lucide="loader" class="w-4 h-4 animate-spin hidden" id="loader"></i>
            </button>
          </form>
        </div>
        <div class="px-8 py-4 bg-slate-50 border-t border-slate-100 text-center">
          <p class="text-[10px] text-slate-400 font-bold uppercase">
            &copy; 2025 Notify Admin Portal
          </p>
        </div>
      </div>
    </div>

    <script>
      lucide.createIcons();
    </script>

    <script>
      document.getElementById('loginForm').addEventListener('submit', function (e) {
        const btn = document.getElementById('loginBtn');

        // inline toggleLoading logic
        btn.dataset.originalText = btn.innerHTML;
        btn.disabled = true;
        btn.classList.add('opacity-75', 'cursor-not-allowed');
        btn.innerHTML = `<svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white inline-block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Signing In...`;
      });
    </script>
  </body>
</html>
