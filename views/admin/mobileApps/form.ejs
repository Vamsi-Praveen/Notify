<div class="flex">
  <div class="w-full max-w-3xl">
    <div class="pb-6 border-b border-slate-100 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <a
          href="/admin/mobile-apps"
          class="p-2 border border-slate-200 rounded text-slate-400 hover:text-slate-600 hover:border-slate-300 transition-all"
        >
          <i data-lucide="arrow-left" class="w-4 h-4"></i>
        </a>
        <div>
          <h2 class="text-lg font-bold text-slate-800">Edit App Details</h2>
          <p class="text-xs text-slate-500 mt-1">
            View and modify mobile application configuration.
          </p>
        </div>
      </div>
    </div>

    <!-- Form -->
    <div class="bg-white border border-slate-200 rounded-lg shadow-sm overflow-hidden mt-6">
      <form id="adminAppForm" class="p-6 space-y-6">
        <input type="hidden" name="id" value="<%= app._id %>" />

        <!-- Tenant Info (Read Only) -->
        <div class="bg-slate-50 p-4 rounded-lg border border-slate-200">
          <label class="block text-xs font-bold text-slate-500 uppercase tracking-wide mb-1">
            Tenant Owner
          </label>
          <div class="flex items-center gap-2">
            <div
              class="w-5 h-5 rounded bg-blue-100 flex items-center justify-center text-blue-700 text-[10px] font-bold"
            >
              <%= app.tenantId.name.substring(0, 2).toUpperCase() %>
            </div>
            <span class="text-sm font-medium text-slate-800"><%= app.tenantId.name %></span>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-6">
          <!-- App Name -->
          <div class="col-span-2 sm:col-span-1">
            <label class="block text-[10px] font-bold text-slate-700 uppercase tracking-wide mb-2">
              App Name <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              name="name"
              value="<%= app.name || '' %>"
              required
              class="w-full px-3 py-2 text-xs border border-slate-200 rounded focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500 transition-colors"
            />
          </div>

          <!-- App ID -->
          <div class="col-span-2 sm:col-span-1">
            <label class="block text-[10px] font-bold text-slate-700 uppercase tracking-wide mb-2">
              Bundle ID / Package Name
            </label>
            <input
              type="text"
              name="appId"
              value="<%= app.appId || '' %>"
              readonly
              class="w-full px-3 py-2 text-xs border border-slate-200 rounded bg-slate-50 text-slate-500 cursor-not-allowed"
            />
          </div>
        </div>

        <!-- Platform -->
        <div>
          <label class="block text-[10px] font-bold text-slate-700 uppercase tracking-wide mb-3">
            Target Platform
          </label>
          <div class="flex gap-4">
            <label
              class="flex items-center gap-2 px-4 py-2 border border-slate-200 rounded cursor-pointer hover:bg-slate-50 input-active-state"
            >
              <input type="radio" name="platform" value="both" <%= (!app.platform || app.platform
              === 'both') ? 'checked' : '' %> class="text-blue-600 focus:ring-blue-500">
              <span class="text-xs font-medium text-slate-700">Both (Android & iOS)</span>
            </label>
            <label
              class="flex items-center gap-2 px-4 py-2 border border-slate-200 rounded cursor-pointer hover:bg-slate-50 input-active-state"
            >
              <input type="radio" name="platform" value="android" <%= app.platform === 'android' ?
              'checked' : '' %> class="text-blue-600 focus:ring-blue-500">
              <span class="text-xs font-medium text-slate-700">Android Only</span>
            </label>
            <label
              class="flex items-center gap-2 px-4 py-2 border border-slate-200 rounded cursor-pointer hover:bg-slate-50 input-active-state"
            >
              <input type="radio" name="platform" value="ios" <%= app.platform === 'ios' ? 'checked'
              : '' %> class="text-blue-600 focus:ring-blue-500">
              <span class="text-xs font-medium text-slate-700">iOS Only</span>
            </label>
          </div>
        </div>

        <!-- Firebase Config -->
        <div class="pt-6 border-t border-slate-100">
          <h3
            class="text-xs font-bold text-slate-800 uppercase tracking-widest mb-4 flex items-center gap-2"
          >
            <i data-lucide="flame" class="w-4 h-4 text-orange-500"></i>
            Firebase Credentials (Update Only)
          </h3>

          <div class="space-y-4">
            <div>
              <label
                class="block text-[10px] font-bold text-slate-700 uppercase tracking-wide mb-2"
              >
                Service Account JSON
              </label>
              <div class="relative">
                <textarea
                  name="serviceAccountJson"
                  rows="5"
                  class="w-full px-3 py-2 text-[10px] font-mono border border-slate-200 rounded focus:outline-none focus:ring-1 focus:ring-blue-500 focus:border-blue-500 transition-colors"
                  placeholder="Paste new JSON here to update credentials. Leave empty to keep existing."
                ></textarea>
                <div class="absolute top-2 right-2">
                  <span
                    class="inline-flex items-center px-2 py-1 rounded text-[10px] font-medium bg-green-50 text-green-700 border border-green-100"
                  >
                    Credentials Exist
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Active Status -->
        <div class="flex items-center gap-3 pt-4 border-t border-slate-100">
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" name="isActive" class="sr-only peer" <%= app.isActive ? 'checked'
            : '' %>>
            <div
              class="w-9 h-5 bg-slate-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-blue-600"
            ></div>
            <span class="ml-3 text-xs font-medium text-slate-700">Active Status</span>
          </label>
        </div>

        <!-- Submit -->
        <div class="pt-6 border-t border-slate-100 flex items-center justify-end gap-3">
          <a
            href="/admin/mobile-apps"
            class="px-4 py-2 text-[10px] font-bold text-slate-500 hover:text-slate-800 uppercase tracking-widest transition-colors"
          >
            Cancel
          </a>
          <button
            type="submit"
            class="px-6 py-2 bg-blue-600 text-white text-[10px] font-bold uppercase tracking-widest rounded hover:bg-blue-700 transition-colors shadow-sm inline-flex items-center gap-2"
          >
            <i data-lucide="save" class="w-4 h-4"></i>
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  const form = document.getElementById('adminAppForm');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = e.target.querySelector('button[type="submit"]');
    toggleLoading(submitBtn, true, 'SAVING...');

    const formData = new FormData(form);
    const id = formData.get('id');
    const data = {
      name: formData.get('name'),
      platform: formData.get('platform'),
      isActive: formData.get('isActive') === 'on',
      serviceAccountJson: formData.get('serviceAccountJson'),
    };

    if (!data.serviceAccountJson) {
      delete data.serviceAccountJson;
    }

    try {
      const response = await fetch(`/admin/admin-api/mobile-apps/${id}`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (response.ok) {
        window.location.href = '/admin/mobile-apps';
      } else {
        alert(result.message || 'Failed to update app');
        toggleLoading(submitBtn, false);
      }
    } catch (error) {
      console.error('Error:', error);
      alert('An error occurred. Please try again.');
      toggleLoading(submitBtn, false);
    }
  });

  // Highlight active radio parent
  const radios = document.querySelectorAll('input[type="radio"]');
  radios.forEach((radio) => {
    radio.addEventListener('change', () => {
      radios.forEach((r) => {
        if (r.checked) {
          r.closest('label').classList.add('bg-blue-50', 'border-blue-200');
        } else {
          r.closest('label').classList.remove('bg-blue-50', 'border-blue-200');
        }
      });
    });
    if (radio.checked) {
      radio.closest('label').classList.add('bg-blue-50', 'border-blue-200');
    }
  });
</script>
