<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-lg font-bold text-slate-800">Mobile Apps</h2>
      <p class="text-xs text-slate-500 mt-1">Overview of all Tenant mobile applications.</p>
    </div>
  </div>

  <!-- Apps List -->
  <div class="grid gap-4">
    <% if (apps && apps.length > 0) { %>
    <div class="bg-white border border-slate-200 rounded-lg overflow-hidden shadow-sm">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-50 border-b border-slate-100">
          <tr>
            <th class="px-6 py-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest">
              Tenant
            </th>
            <th class="px-6 py-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest">
              App Name
            </th>
            <th class="px-6 py-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest">
              App ID
            </th>
            <th class="px-6 py-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest">
              Platform
            </th>
            <th class="px-6 py-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest">
              Status
            </th>
            <th class="px-6 py-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest">
              Created At
            </th>
            <th
              class="px-6 py-4 text-[10px] font-bold text-slate-500 uppercase tracking-widest text-right"
            >
              Actions
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% apps.forEach(app => { %>
          <tr class="hover:bg-slate-50/50 transition-colors">
            <td class="px-6 py-4">
              <% if (app.tenantId) { %>
              <div class="flex items-center gap-2">
                <div
                  class="w-6 h-6 rounded bg-blue-100 flex items-center justify-center text-blue-700 text-[10px] font-bold"
                >
                  <%= app.tenantId.name.substring(0, 2).toUpperCase() %>
                </div>
                <span class="text-xs text-slate-700 font-medium"><%= app.tenantId.name %></span>
              </div>
              <% } else { %>
              <span class="text-xs text-slate-400 italic">Unknown Tenant</span>
              <% } %>
            </td>
            <td class="px-6 py-4 font-medium text-slate-800 text-xs"><%= app.name %></td>
            <td class="px-6 py-4 text-slate-600 font-mono text-[10px]"><%= app.appId %></td>
            <td class="px-6 py-4">
              <div class="flex items-center gap-2">
                <% if (app.platform === 'android' || app.platform === 'both') { %>
                <span
                  class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-green-100 text-green-800 uppercase"
                  >Android</span
                >
                <% } %> <% if (app.platform === 'ios' || app.platform === 'both') { %>
                <span
                  class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-slate-100 text-slate-800 uppercase"
                  >iOS</span
                >
                <% } %>
              </div>
            </td>
            <td class="px-6 py-4">
              <% if (app.isActive) { %>
              <span
                class="inline-flex items-center gap-1.5 px-1.5 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-50 text-emerald-700 border border-emerald-100"
              >
                Active
              </span>
              <% } else { %>
              <span
                class="inline-flex items-center gap-1.5 px-1.5 py-0.5 rounded text-[10px] font-bold uppercase bg-slate-100 text-slate-400 border border-slate-200"
              >
                Inactive
              </span>
              <% } %>
            </td>
            <td class="px-6 py-4 text-[10px] text-slate-500">
              <%= new Date(app.createdAt).toLocaleDateString() %>
            </td>
            <td class="px-6 py-4 text-right">
              <a
                href="/admin/mobile-apps/<%= app._id %>/edit"
                class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-slate-400 hover:text-blue-600 transition-colors"
              >
                <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
              </a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
    <div class="text-center py-20 bg-slate-50 rounded-lg border-2 border-dashed border-slate-200">
      <div
        class="w-16 h-16 bg-slate-100/50 rounded-full flex items-center justify-center mx-auto mb-4"
      >
        <i data-lucide="smartphone" class="w-8 h-8 text-slate-400"></i>
      </div>
      <h3 class="text-sm font-medium text-slate-900">No apps found</h3>
      <p class="text-xs text-slate-500 mt-1">
        No mobile applications have been registered by tenants yet.
      </p>
    </div>
    <% } %>
  </div>
</div>
