<div class="max-w-4xl space-y-8">
  <div class="pb-6 border-b border-slate-100 flex items-center justify-between">
    <div class="flex items-center gap-4">
      <a
        href="/admin/tenants"
        class="p-2 border border-slate-200 rounded text-slate-400 hover:text-slate-600 hover:border-slate-300"
      >
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
      </a>
      <div>
        <h2 class="text-lg font-bold text-slate-800 tracking-tight">
          <%= tenant._id ? 'Edit Tenant' : 'Create New Tenant' %>
        </h2>
        <p class="text-[10px] text-slate-500 mt-1 uppercase tracking-widest font-bold">
          Tenant Configuration
        </p>
      </div>
    </div>
  </div>

  <div class="bg-white border border-slate-200 rounded-lg p-8 shadow-sm">
    <form id="tenantForm" class="space-y-8">
      <% if (tenant._id) { %>
      <input type="hidden" name="id" value="<%= tenant._id %>" />
      <% } %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="space-y-2">
          <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest" for="name"
            >Tenant Name</label
          >
          <input
            type="text"
            name="name"
            id="name"
            required
            placeholder="ACME_HQ"
            value="<%= tenant.name || '' %>"
            class="w-full px-3 py-2.5 rounded border border-slate-200 focus:border-blue-600 outline-none text-xs font-semibold"
          />
        </div>

        <div class="space-y-2">
          <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest" for="email"
            >Admin Email</label
          >
          <input
            type="email"
            name="email"
            id="email"
            required
            placeholder="dev-ops@acme.internal"
            value="<%= tenant.email || '' %>"
            class="w-full px-3 py-2.5 rounded border border-slate-200 focus:border-blue-600 outline-none text-xs font-semibold"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <% if (!tenant._id) { %>
        <div class="space-y-2">
          <label
            class="text-[10px] font-bold text-slate-400 uppercase tracking-widest"
            for="password"
            >Initial Password</label
          >
          <input
            type="password"
            name="password"
            id="password"
            required
            class="w-full px-3 py-2.5 rounded border border-slate-200 focus:border-blue-600 outline-none text-xs font-semibold"
          />
        </div>
        <% } %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="space-y-2">
          <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest" for="maxPriority">Max Priority</label>
          <select name="maxPriority" id="maxPriority" class="w-full px-3 py-2.5 rounded border border-slate-200 focus:border-blue-600 outline-none text-xs bg-white font-semibold">
            <option value="critical" <%= tenant.maxPriority === 'critical' ? 'selected' : '' %>>Critical (Full Access)</option>
            <option value="high" <%= tenant.maxPriority === 'high' ? 'selected' : '' %>>High</option>
            <option value="medium" <%= tenant.maxPriority === 'medium' || !tenant.maxPriority ? 'selected' : '' %>>Medium (Standard)</option>
            <option value="low" <%= tenant.maxPriority === 'low' ? 'selected' : '' %>>Low (Restricted)</option>
          </select>
        </div>
        <div class="space-y-2 flex items-center pt-6">
          <label class="flex items-center gap-2 cursor-pointer group">
            <input type="checkbox" name="isActive" class="w-4 h-4 rounded text-blue-600
            border-slate-300" <%= tenant.isActive !== false ? 'checked' : '' %>>
            <span
              class="text-[10px] font-bold text-slate-500 uppercase tracking-widest group-hover:text-slate-800 transition-colors"
              >Active Status</span
            >
          </label>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-4">
        <div class="space-y-2">
          <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest" for="rateLimitPoints"
            >Rate Limit Quota (Total Points)</label
          >
          <input
            type="number"
            name="rateLimitPoints"
            id="rateLimitPoints"
            required
            placeholder="100"
            value="<%= tenant.rateLimitPoints || 100 %>"
            class="w-full px-3 py-2.5 rounded border border-slate-200 focus:border-blue-600 outline-none text-xs font-semibold"
          />
          <p class="text-[9px] text-slate-400 font-medium uppercase tracking-tight">Maximum number of requests permitted within the window.</p>
        </div>

        <div class="space-y-2">
          <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest" for="rateLimitDuration"
            >Rate Limit Window (Seconds)</label
          >
          <input
            type="number"
            name="rateLimitDuration"
            id="rateLimitDuration"
            required
            placeholder="900"
            value="<%= tenant.rateLimitDuration || 900 %>"
            class="w-full px-3 py-2.5 rounded border border-slate-200 focus:border-blue-600 outline-none text-xs font-semibold"
          />
          <p class="text-[9px] text-slate-400 font-medium uppercase tracking-tight">Time duration (in seconds) for the rate limit cycle.</p>
        </div>
      </div>
          <p class="text-[9px] text-slate-400 font-medium uppercase tracking-tight">Time duration (in seconds) for the rate limit cycle.</p>
        </div>

        <div class="space-y-2 md:col-span-2">
          <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest" for="allowedIps"
            >Allowed IPs (Optional)</label
          >
          <p class="text-[9px] text-slate-400 mb-1">Newline separated. Leave empty to allow all.</p>
          <textarea
            name="allowedIps"
            id="allowedIps"
            rows="3"
            placeholder="192.168.1.1&#10;10.0.0.5"
            class="w-full px-3 py-2.5 rounded border border-slate-200 focus:border-blue-600 outline-none text-xs font-mono bg-slate-50"
          ><%= tenant.allowedIps ? tenant.allowedIps.join('\n') : '' %></textarea>
        </div>
      </div>
      </div>

      <!-- Allowed Channels -->
      <div class="pt-8 border-t border-slate-100">
        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-4 block"
          >Allowed Channels</label
        >
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          <% ['email', 'sms', 'push', 'in-app', 'slack', 'teams', 'telegram'].forEach(channel => {
          %>
          <label
            class="flex items-center gap-3 p-3 rounded border border-slate-100 bg-slate-50/50 hover:bg-white hover:border-blue-100 transition-all cursor-pointer group"
          >
            <input type="checkbox" name="allowedChannels" value="<%= channel %>" class="w-3.5 h-3.5
            rounded text-blue-600 border-slate-300" <%= tenant.allowedChannels &&
            tenant.allowedChannels.includes(channel) ? 'checked' : '' %>>
            <span
              class="text-[10px] font-bold text-slate-500 uppercase tracking-widest group-hover:text-slate-800 capitalize"
              ><%= channel %></span
            >
          </label>
          <% }) %>
        </div>
      </div>

      <!-- Initial Permissions (Create Only) -->
      <% if (!tenant._id) { %>
      <div class="pt-8 border-t border-slate-100">
        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2 block"
          >Initial Permissions</label
        >
        <p class="text-[9px] text-slate-400 font-medium uppercase tracking-tight mb-4">
          Default access scopes for this tenant.
        </p>

        <div
          class="grid grid-cols-1 sm:grid-cols-2 gap-3 p-4 bg-slate-50/50 rounded-lg border border-slate-100"
        >
           <label
            class="flex items-center gap-3 p-2 rounded border border-transparent hover:border-slate-200 transition-all cursor-pointer"
          >
            <input
              type="checkbox"
              name="scopes"
              value="event:write"
              checked
              disabled
              class="w-3.5 h-3.5 rounded text-blue-600"
            />
            <span class="text-[10px] font-bold text-slate-600 uppercase"
              >Events Write (event:write)</span
            >
          </label>
          <label
            class="flex items-center gap-3 p-2 rounded border border-transparent hover:border-slate-200 transition-all cursor-pointer"
          >
            <input
              type="checkbox"
              name="scopes"
              value="notify:send"
              checked
              class="w-3.5 h-3.5 rounded text-blue-600"
            />
            <span class="text-[10px] font-bold text-slate-600 uppercase"
              >Notify Send (notify:send)</span
            >
          </label>
          <label
            class="flex items-center gap-3 p-2 rounded border border-transparent hover:border-slate-200 transition-all cursor-pointer"
          >
            <input
              type="checkbox"
              name="scopes"
              value="notify:read"
              checked
              class="w-3.5 h-3.5 rounded text-blue-600"
            />
            <span class="text-[10px] font-bold text-slate-600 uppercase"
              >Notify Read (notify:read)</span
            >
          </label>
          <label
            class="flex items-center gap-3 p-2 rounded border border-transparent hover:border-slate-200 transition-all cursor-pointer"
          >
            <input
              type="checkbox"
              name="scopes"
              value="files:upload"
              checked
              class="w-3.5 h-3.5 rounded text-blue-600"
            />
            <span class="text-[10px] font-bold text-slate-600 uppercase"
              >Files Upload (files:upload)</span
            >
          </label>
        </div>
      </div>
      <% } %>

      <!-- Buttons -->
      <div class="pt-8 flex items-center justify-end gap-3 border-t border-slate-100">
        <a
          href="/admin/tenants"
          class="px-6 py-2.5 text-[10px] font-bold text-slate-400 hover:text-slate-600 uppercase tracking-widest transition-colors"
          >Cancel</a
        >
        <button
          type="submit"
          id="submitBtn"
          class="px-8 py-2.5 bg-slate-900 hover:bg-black text-white text-[10px] font-bold uppercase tracking-widest rounded shadow-sm transition-all"
        >
          <%= tenant._id ? 'Update Tenant' : 'Add Tenant' %>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Modal for New API Key -->
<div id="newTenantKeyModal" class="hidden fixed inset-0 z-[60] overflow-y-auto">
  <div class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm"></div>
  <div class="flex min-h-full items-center justify-center p-4">
    <div
      class="relative transform overflow-hidden rounded border border-slate-200 bg-white p-8 shadow-2xl sm:w-full sm:max-w-lg"
    >
      <div class="text-center">
        <div
          class="mx-auto flex h-10 w-10 items-center justify-center rounded bg-emerald-50 mb-4 border border-emerald-100"
        >
          <i data-lucide="check" class="h-5 w-5 text-emerald-600"></i>
        </div>
        <h3 class="text-xs font-bold text-slate-800 uppercase tracking-widest">
          Tenant Created Successfully
        </h3>
        <p
          class="text-[10px] text-slate-500 mt-2 font-medium uppercase tracking-tighter leading-snug"
        >
          The API Key has been generated. Please copy and store it safely now.
        </p>

        <div
          class="mt-6 p-4 bg-slate-50 rounded border border-slate-200 flex items-center justify-between gap-4"
        >
          <code
            id="newTenantKeyDisplay"
            class="text-[10px] font-mono text-blue-600 break-all select-all font-bold"
          ></code>
          <button
            onclick="copyTenantKey()"
            class="text-slate-400 hover:text-slate-600 p-1 flex-shrink-0 transition-colors"
          >
            <i data-lucide="copy" class="w-4 h-4"></i>
          </button>
        </div>

        <button
          onclick="window.location.href='/admin/tenants'"
          class="mt-8 w-full py-3 bg-slate-900 text-white text-[10px] font-bold uppercase tracking-widest rounded hover:bg-black transition-all"
        >
          Acknowledge & Close
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  document.getElementById('tenantForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = document.getElementById('submitBtn');
    toggleLoading(submitBtn, true, 'Validating...');

    const formData = new FormData(e.target);
    const data = {};
    formData.forEach((value, key) => {
      if (key === 'allowedChannels' || key === 'scopes') {
        if (!data[key]) data[key] = [];
        data[key].push(value);
      } else if (key === 'allowedIps') {
         data[key] = value.split('\n').map(ip => ip.trim()).filter(ip => ip.length > 0);
      } else {
        data[key] = value;
      }
    });

    data.isActive = formData.has('isActive');
    const id = formData.get('id');
    const method = id ? 'PUT' : 'POST';
    const url = id ? `/admin/admin-api/tenants/${id}` : '/admin/admin-api/tenants';

    try {
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const json = await res.json();
      if (res.ok) {
        if (method === 'POST' && json.apiKey) {
          document.getElementById('newTenantKeyDisplay').textContent = json.apiKey;
          document.getElementById('newTenantKeyModal').classList.remove('hidden');
          lucide.createIcons();
        } else {
          window.location.href = '/admin/tenants';
        }
      } else {
        showAlert(json.message || 'Validation Failure');
        toggleLoading(submitBtn, false);
      }
    } catch (e) {
      showAlert('Gateway communication error');
      toggleLoading(submitBtn, false);
    }
  });

  function copyTenantKey() {
    const key = document.getElementById('newTenantKeyDisplay').textContent;
    navigator.clipboard.writeText(key);
    const btn = document.querySelector('button[onclick="copyTenantKey()"]');
    const originalContent = btn.innerHTML;
    btn.innerHTML = '<i data-lucide="check" class="w-4 h-4 text-emerald-600"></i>';
    lucide.createIcons();
    setTimeout(() => {
      btn.innerHTML = originalContent;
      lucide.createIcons();
    }, 2000);
  }

  lucide.createIcons();
</script>
