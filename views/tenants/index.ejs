<div class="max-w-7xl mx-auto space-y-6">
  <div class="pb-6 border-b border-slate-100 flex items-center justify-between">
    <div>
      <h2 class="text-lg font-bold text-slate-800">All Tenants</h2>
      <p class="text-xs text-slate-500 mt-1">
        Manage your tenants and their notification settings.
      </p>
    </div>
    <a
      href="/admin/tenants/new"
      class="inline-flex items-center px-4 py-2 bg-slate-900 hover:bg-black text-white text-[10px] font-bold uppercase tracking-widest rounded transition-all gap-2"
    >
      <i data-lucide="plus" class="w-3.5 h-3.5"></i> Add Tenant
    </a>
  </div>

  <div class="bg-white border border-slate-200 rounded-lg overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead
          class="bg-slate-50/50 text-[10px] font-bold text-slate-500 uppercase tracking-widest border-b border-slate-100"
        >
          <tr>
            <th class="px-6 py-4">Tenant Name</th>
            <th class="px-6 py-4">Email</th>
            <th class="px-6 py-4">Max Priority</th>
            <th class="px-6 py-4">Created</th>
            <th class="px-6 py-4">Status</th>
            <th class="px-6 py-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% if (tenants && tenants.length > 0) { %> <% tenants.forEach(tenant => { %>
          <tr class="hover:bg-slate-50/50 transition-colors">
            <td class="px-6 py-4">
              <div class="text-xs font-bold text-slate-800"><%= tenant.name %></div>
              <div class="text-[10px] text-slate-400 font-mono uppercase">
                ID: <%= tenant._id.toString().slice(-6) %>
              </div>
            </td>
            <td class="px-6 py-4 text-xs font-medium text-slate-600"><%= tenant.email %></td>
            <td class="px-6 py-4">
              <span
                class="text-[10px] font-bold text-slate-500 uppercase bg-slate-100 px-1.5 py-0.5 rounded border border-slate-200"
              >
                <%= tenant.maxPriority || 'medium' %>
              </span>
            </td>
            <td class="px-6 py-4 text-[10px] text-slate-400">
              <%= new Date(tenant.createdAt).toLocaleDateString() %>
            </td>
            <td class="px-6 py-4">
              <span
                class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-bold uppercase border <%= tenant.isActive ? 'bg-emerald-50 text-emerald-700 border-emerald-100' : 'bg-slate-100 text-slate-400 border-slate-200' %>"
              >
                <%= tenant.isActive ? 'Active' : 'Inactive' %>
              </span>
            </td>
            <td class="px-6 py-4 text-right">
              <div class="flex items-center justify-end gap-2">
                <a
                  href="/admin/tenants/<%= tenant._id %>/edit"
                  class="p-1.5 text-slate-400 hover:text-blue-600 transition-colors"
                >
                  <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                </a>
                <button
                  onclick="deleteTenant('<%= tenant._id %>', '<%= tenant.name %>')"
                  class="p-1.5 text-slate-400 hover:text-red-600 transition-colors"
                >
                  <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                </button>
              </div>
            </td>
          </tr>
          <% }) %> <% } else { %>
          <tr>
            <td colspan="5" class="px-6 py-20 text-center text-slate-400">
              <div class="flex flex-col items-center gap-3">
                <i data-lucide="users-2" class="w-10 h-10 text-slate-200"></i>
                <p class="text-xs lowercase">No tenants found.</p>
              </div>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  async function deleteTenant(id, name) {
    if (
      !(await showVerify(
        'This will permanently delete the tenant and all its associated data.',
        name
      ))
    )
      return;
    try {
      const res = await fetch(`/admin/admin-api/tenants/${id}`, { method: 'DELETE' });
      if (res.ok) {
        await showAlert('Tenant deleted', 'success');
        window.location.reload();
      } else {
        showAlert('Failed to delete tenant');
      }
    } catch (e) {
      showAlert('Network error');
    }
  }
  lucide.createIcons();
</script>
