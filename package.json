{
  "name": "notificationservice",
  "version": "1.0.0",
  "description": "Notification Service",
  "license": "ISC",
  "author": "Vamsi Praveen, Sai Ram Charan",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "dev": "concurrently -n \"API,WORKER,DISPATCHER\" -c \"blue,yellow,green\" \"nodemon scripts/startup.js | pino-pretty\" \"nodemon scripts/worker-startup.js | pino-pretty\" \"nodemon scripts/dispatcher.js | pino-pretty\"",
    "start": "node startup.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.1",
    "bullmq": "^5.65.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "ejs": "^3.1.10",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "handlebars": "^4.7.8",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.6",
    "mongoose": "^9.0.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.11",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "rate-limiter-flexible": "^9.0.1",
    "twilio": "^5.11.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "nodemon": "^3.1.11"
  }
}
